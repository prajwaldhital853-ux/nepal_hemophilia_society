# =========================
# Root environment template
# Copy to .env and fill in values
# =========================

# Django Backend
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.3,0.0.0.0
# Local bootstrap without Docker Postgres
USE_SQLITE=false
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (local via Docker)
POSTGRES_DB=nepal_hemophilia
POSTGRES_USER=hemophilia_user
POSTGRES_PASSWORD=hemophilia_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend API URL (used by frontend/mobile)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_BASE_URL=http://localhost:8000

# Admin Panel (Next.js)
NEXT_PUBLIC_APP_NAME=NHMS Admin
ADMIN_PANEL_PORT=3000

# Public Website (Next.js)
WEBSITE_PORT=3001

# JWT / Auth
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File uploads
MAX_UPLOAD_SIZE_MB=10
MEDIA_URL=/media/

# SMS (Nepal - configure later)
SMS_API_KEY=
SMS_SENDER_ID=

# Email (configure later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
