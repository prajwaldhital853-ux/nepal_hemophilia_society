# =========================
# Root environment template
# Copy to .env and fill in values
# =========================

# Django Backend
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
# Render production: set DJANGO_API_DEBUG_ERRORS=true temporarily to return JSON error details from 500s (disable after fixing)
# DJANGO_API_DEBUG_ERRORS=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.3,0.0.0.0
# Local bootstrap without Docker Postgres
USE_SQLITE=false
# Render/Heroku: link Postgres — DATABASE_URL is set automatically (do not set POSTGRES_HOST=localhost on Render)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL (local via Docker)
POSTGRES_DB=nepal_hemophilia
POSTGRES_USER=hemophilia_user
POSTGRES_PASSWORD=hemophilia_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend API URL (used by frontend/mobile)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_BASE_URL=http://localhost:8000

# Admin Panel (Next.js)
NEXT_PUBLIC_APP_NAME=NHMS Admin
ADMIN_PANEL_PORT=3000

# Public Website (Next.js)
WEBSITE_PORT=3001

# JWT / Auth
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ADMIN_ACCESS_HOURS=8
JWT_ADMIN_REFRESH_HOURS=12
JWT_PATIENT_ACCESS_DAYS=7
JWT_PATIENT_REFRESH_DAYS=30
# Required when DJANGO_DEBUG=False. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# File uploads (local dev). On Render, set Cloudinary vars — uploads go to CDN automatically.
MAX_UPLOAD_SIZE_MB=10
MEDIA_URL=/media/
# Render backend only — use ONE method, not both (mixed vars cause "Invalid Signature" on uploads):
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or set all three instead of CLOUDINARY_URL (do not set both):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SMS (Nepal - configure later)
SMS_API_KEY=
SMS_SENDER_ID=

# Email (configure later)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
