# Default (no .env needed): Expo Go uses Render automatically.
# EXPO_PUBLIC_API_URL=https://nepal-hemophilia-society.onrender.com/api/v1

# Local Django on your PC (same Wi‑Fi as phone) — both lines required:
# EXPO_PUBLIC_USE_LOCAL_API=true
# EXPO_PUBLIC_API_URL=http://192.168.1.3:8000/api/v1

# Android emulator only:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
