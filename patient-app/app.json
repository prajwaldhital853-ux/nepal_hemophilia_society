{
  "expo": {
    "name": "NHMS Patient",
    "slug": "nhms-patient-app",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/nhs-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/nhs-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nepalhemophilia.patient"
    },
    "android": {
      "package": "org.nepalhemophilia.patient",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/nhs-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "ipo_ipo",
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "usesCleartextTraffic": true,
            "newArchEnabled": false,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8919ccf0-a07c-4b24-9d27-830075164e68"
      }
    }
  }
}
