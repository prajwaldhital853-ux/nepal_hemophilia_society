{
  "expo": {
    "name": "NHMS Patient",
    "slug": "nhms-patient-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/nhs-logo-icon-clear.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/nhs-logo-icon-clear.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nepalhemophilia.patient"
    },
    "android": {
      "package": "org.nepalhemophilia.patient",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/nhs-logo-icon-clear.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "bulkipo",
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nhs-logo-icon-clear.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5949c31a-d08d-4fd2-8889-810a877cf039"
      }
    }
  }
}
