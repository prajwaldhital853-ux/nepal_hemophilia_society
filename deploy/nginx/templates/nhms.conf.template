# Replace these hostnames in deploy/.env before first start.
# TLS: run `deploy/scripts/enable-https.sh` after DNS points to the VPS.

upstream nhms_api {
    server api:8000;
}

upstream nhms_admin {
    server admin:3000;
}

upstream nhms_website {
    server website:3001;
}

# API — api.yourdomain.org.np
server {
    listen 80;
    server_name ${API_HOST};

    location /media/ {
        alias /var/www/media/;
        add_header Cache-Control "private, max-age=3600";
    }

    location / {
        proxy_pass http://nhms_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# Admin panel — admin.yourdomain.org.np
server {
    listen 80;
    server_name ${ADMIN_HOST};

    location / {
        proxy_pass http://nhms_admin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Public website — www.yourdomain.org.np (+ apex)
server {
    listen 80;
    server_name ${WWW_HOST} ${APEX_HOST};

    location / {
        proxy_pass http://nhms_website;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
