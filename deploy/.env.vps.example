# Copy to deploy/.env and fill in before:
#   cd deploy && docker compose -f docker-compose.prod.yml up -d --build

CERTBOT_EMAIL=admin@nepalhemophilia.org.np

# --- Domains (DNS A records → your VPS IP) ---
API_HOST=api.nepalhemophilia.org.np
ADMIN_HOST=admin.nepalhemophilia.org.np
WWW_HOST=www.nepalhemophilia.org.np
APEX_HOST=nepalhemophilia.org.np

# --- Django API ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.nepalhemophilia.org.np,localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://admin.nepalhemophilia.org.np,https://www.nepalhemophilia.org.np,https://nepalhemophilia.org.np
DJANGO_SECURE_SSL_REDIRECT=true
ADMIN_PANEL_URL=https://admin.nepalhemophilia.org.np

# Built into admin Docker image at build time
NEXT_PUBLIC_API_URL=https://api.nepalhemophilia.org.np/api/v1

# --- Postgres (internal Docker network) ---
POSTGRES_DB=nepal_hemophilia
POSTGRES_USER=hemophilia_user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Production seeding (keep false after first deploy) ---
RUN_SEED_ON_START=false
RUN_DEMO_SEED_ON_START=false
RESET_SUPER_ADMIN_ON_START=false

SUPER_ADMIN_TEMP_PASSWORD=
SUPER_ADMIN_EMAIL=superadmin@hemophilia.org.np
NHMS_SEED_STAFF_PASSWORD=
NHMS_DEMO_PASSWORD=

# --- Auth / backups / cron ---
BACKUP_ENCRYPTION_KEY=
CRON_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_REQUIRE_TOTP=true

# --- Email (Gmail app password or SMTP provider) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@nepalhemophilia.org.np

# --- Uploads: Cloudinary (recommended) OR local disk via /media volume ---
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Firebase push ---
# FIREBASE_CREDENTIALS_JSON=
